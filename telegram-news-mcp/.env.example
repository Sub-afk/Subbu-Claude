# Get these from https://my.telegram.org -> "API development tools"
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# The group that receives the daily news PDF. Any of:
#   @groupusername | https://t.me/groupusername | -1001234567890 (numeric id) | exact group title
TG_NEWS_GROUP=My Daily News Group

# Where the Telethon login session lives. Treat this file like a password.
TG_SESSION=~/.telegram-news-mcp/session

# Where downloaded PDFs and extracted text are cached.
NEWS_DOWNLOAD_DIR=~/.telegram-news-mcp/downloads

# Optional: comma-separated interests used to rank pages (case-insensitive).
NEWS_TOPICS=economy,technology,AI,climate,science,India,world
